+/// when it keys up, the one listened to fewest times first (ex_pick_id); it stays while the
+/// carrier is up, then AUTO_TAIL_MS more, AUTO_MAX_S at most, and leaves AUTO_GAP_MS of sweep
+/// before the next. A call needs two decodes alike, on one listen or two.
+const AUTO_MAX_S: u32 = 120;
+const AUTO_TAIL_MS: u32 = 3000;
